# Copy to .env.local for local Docker Compose development. Never commit real values.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=media-engine
MINIO_ROOT_PASSWORD=
# Unique token for the worker bundled with compose.yaml. Remote workers receive their own token in the dashboard.
MEDIA_ENGINE_LOCAL_WORKER_TOKEN=
MEDIA_ENGINE_ADMIN_USERNAME=admin
MEDIA_ENGINE_ADMIN_PASSWORD=
MEDIA_ENGINE_ADMIN_SESSION_SECRET=
# Set true when the dashboard is served over HTTPS.
MEDIA_ENGINE_ADMIN_SESSION_COOKIE_SECURE=false
# URL-safe base64 encoding of exactly 32 random bytes (a Fernet key).
MEDIA_ENGINE_CREDENTIAL_ENCRYPTION_KEY=

# Optional one-time imports. Provider credentials can also be added through the management API/UI.
OPENAI_API_KEY=

XAI_API_KEY=

# Optional host-facing ports and retention settings.
MEDIA_ENGINE_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEDIA_ENGINE_ASSET_RETENTION_HOURS=24
MEDIA_ENGINE_PIPELINE_RETENTION_HOURS=24
# Set when remote workers need a different object-store URL than local Compose workers.
MEDIA_ENGINE_S3_WORKER_ENDPOINT_URL=http://minio:9000
# Optional worker-only API hostname shown in generated dashboard configuration.
MEDIA_ENGINE_WORKER_ADVERTISED_API_URL=
# cpu, rkmpp, or empty to let either backend claim new transcode stages.
MEDIA_ENGINE_TRANSCODE_REQUIRED_BACKEND=cpu

# Webhooks require HTTPS and public destinations by default. Enable only for isolated local testing.
MEDIA_ENGINE_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false
MEDIA_ENGINE_WEBHOOK_MAX_ATTEMPTS=8
MEDIA_ENGINE_WEBHOOK_TIMEOUT_SECONDS=10
