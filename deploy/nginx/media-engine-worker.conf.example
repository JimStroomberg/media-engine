# Optional restricted hostname for standalone Media Engine workers.
#
# Prefer a private VPN and address the control plane over that network. Use
# this public-host example only when a private route is unavailable. Replace
# the documentation-only IP allowlist before enabling the server.
#
# Set on each standalone worker:
#   MEDIA_ENGINE_WORKER_API_URL=https://workers.media.example.com
#
# This hostname exposes only /v2/internal/*. Every request still requires an
# individually revocable worker token. It does not expose the dashboard or client API.

upstream media_engine_worker_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name workers.media.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name workers.media.example.com;

    ssl_certificate     /etc/letsencrypt/live/workers.media.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workers.media.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 10m;

    access_log /var/log/nginx/media-engine-workers.access.log;
    error_log  /var/log/nginx/media-engine-workers.error.log;

    location ^~ /v2/internal/ {
        # Replace with every worker's fixed egress IP or private VPN range.
        # 192.0.2.0/24 is reserved for documentation and intentionally matches
        # no real public worker until the operator changes it.
        allow 192.0.2.0/24;
        deny all;

        proxy_pass http://media_engine_worker_api;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        proxy_request_buffering off;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
