# Copy to .env.worker on every worker node. Never commit the filled file.

# Pin an immutable release. Hardware Compose variants use their matching image prefix:
#   RK1:             jimstro/media-engine:rk1-0.4.1
#   Xavier NX 16GB:  jimstro/media-engine:jetson-xavier-nx-0.4.1
MEDIA_ENGINE_WORKER_IMAGE=jimstro/media-engine:0.4.1
MEDIA_ENGINE_WORKER_PULL_POLICY=always

# Create this worker in Dashboard -> Workers -> Add worker, then paste the generated values.
# The URL must expose /v2/internal/* over HTTPS or a trusted private network.
MEDIA_ENGINE_WORKER_API_URL=https://media-engine.example.com
MEDIA_ENGINE_WORKER_TOKEN=

# Optional tuning. The Compose flavour supplies the backend and profile.
MEDIA_ENGINE_WORKER_HOSTNAME=worker-node-01
MEDIA_ENGINE_WORKER_HEARTBEAT_SECONDS=20
MEDIA_ENGINE_WORKER_POLL_SECONDS=2
# A media command is stopped after 30 minutes total or 2 minutes without progress.
MEDIA_ENGINE_MEDIA_COMMAND_TIMEOUT_SECONDS=1800
MEDIA_ENGINE_MEDIA_NO_PROGRESS_TIMEOUT_SECONDS=120
