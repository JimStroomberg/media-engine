# Copy to .env.worker on every worker node. Never commit the filled file.

# Use an immutable version tag in production, for example jimstro/media-engine:0.2.0
# or jimstro/media-engine:rk1-0.2.0 with compose.worker-rk1.yaml.
MEDIA_ENGINE_WORKER_IMAGE=
MEDIA_ENGINE_WORKER_PULL_POLICY=always

# The control-plane API must be reachable from this host. Use HTTPS or a private VPN.
MEDIA_ENGINE_WORKER_API_URL=https://media-engine.example.com
# Must exactly match MEDIA_ENGINE_WORKER_API_TOKEN on the control plane.
MEDIA_ENGINE_WORKER_API_TOKEN=

# Every running worker needs its own stable key. Do not reuse it on another worker.
MEDIA_ENGINE_WORKER_KEY=cpu-worker-ams-01
MEDIA_ENGINE_WORKER_DISPLAY_NAME=Amsterdam CPU worker 01

# The worker connects directly to the same S3 bucket as the control plane.
# Leave the endpoint empty only when using the AWS S3 default endpoint.
MEDIA_ENGINE_S3_ENDPOINT_URL=https://s3.example.com
MEDIA_ENGINE_S3_ACCESS_KEY_ID=
MEDIA_ENGINE_S3_SECRET_ACCESS_KEY=
MEDIA_ENGINE_S3_BUCKET=media-engine
MEDIA_ENGINE_S3_REGION=us-east-1
# Use true for MinIO and false for normal AWS virtual-hosted addressing.
MEDIA_ENGINE_S3_FORCE_PATH_STYLE=true

# Optional tuning.
MEDIA_ENGINE_WORKER_HEARTBEAT_SECONDS=20
MEDIA_ENGINE_WORKER_POLL_SECONDS=2
